# Copia este archivo como ".env" (mismo directorio) y completa los valores.
# El archivo .env NO se sube a git y esta bloqueado por .htaccess.

# Acceso al gestor de certificados (upload_cert.php).
# Si estan vacios, el login queda deshabilitado.
ADMIN_USER=
# Genera el hash con:  php -r "echo password_hash('TU_CLAVE_LARGA', PASSWORD_DEFAULT);"
ADMIN_PASS_HASH=

# (Opcional) Direccion publica de esta API, sin barra final. Util si el servidor
# esta detras de HTTPS/proxy y la deteccion automatica falla.
# Ejemplo: https://midominio.com/API_SUNAT
API_BASE_URL=
