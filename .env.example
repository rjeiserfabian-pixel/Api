# Copia este archivo como ".env" (mismo directorio) y completa los valores.
# El archivo .env NO se sube a git y esta bloqueado por .htaccess.

# Acceso al gestor de certificados (upload_cert.php).
# Si estan vacios, el login queda deshabilitado.
ADMIN_USER=
# Genera el hash con:  php -r "echo password_hash('TU_CLAVE_LARGA', PASSWORD_DEFAULT);"
ADMIN_PASS_HASH=

# (Opcional) Direccion publica de esta API, sin barra final. Util si el servidor
# esta detras de HTTPS/proxy y la deteccion automatica falla.
# Ejemplo: https://midominio.com/API_SUNAT
API_BASE_URL=

# --- API v1 (los genera "php bin/admin.php init") ---
# Llave maestra para cifrar claves SOL en la base. RESPALDELA: sin ella no se pueden descifrar.
APP_KEY=
# Token que la API v1 envia al motor interno.
INTERNAL_TOKEN=
# Ponga 1 para que post.php, baja.php, etc. solo acepten llamadas de la API v1 (recomendado).
BLOQUEAR_LEGACY=
# (Opcional) Base de datos MySQL en lugar de SQLite:
# DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=api_sunat      (PostgreSQL, recomendado en produccion)
# DB_DSN=mysql:host=127.0.0.1;dbname=api_sunat;charset=utf8mb4
# DB_USER=
# DB_PASS=
# (Opcional) URL interna con la que /v1 llama al motor si no es http://127.0.0.1/API_SUNAT
# API_INTERNAL_URL=

# --- Reintentos automaticos y webhooks (bin/worker.php) ---
# Direccion PUBLICA de la API (sin barra final). Los enlaces a XML/CDR/PDF que genera el worker y viajan en los avisos la usan.
# API_BASE_URL=https://midominio.com/API_SUNAT
# SOLO DESARROLLO: permite webhooks hacia direcciones locales/privadas (por defecto se rechazan por seguridad).
# WEBHOOKS_PERMITIR_REDES_PRIVADAS=1

# --- Planes y limites (v1/src/Planes.php) ---
# Tope GLOBAL de emisiones por minuto entre TODOS los clientes (protege a SUNAT y evita que uno degrade a los demas).
# Por defecto 150; 0 = sin tope. Los limites por plan se configuran con: php bin/admin.php plan:crear ...
# LIMITE_GLOBAL_SUNAT_MIN=150

# --- Portal de clientes (/portal) ---
# En PRODUCCION: exige HTTPS (redirige a API_BASE_URL) y marca la cookie de sesion como Secure.
# PORTAL_REQUIERE_HTTPS=1
# Solo si hay un proxy/balanceador propio que termina el HTTPS y envia X-Forwarded-Proto (si no, dejelo apagado).
# PORTAL_PROXY_CONFIABLE=1

# --- Panel del operador (/operador) ---
# Lista blanca opcional de IP que pueden ver el panel (separadas por coma). Desde otra IP el panel "no existe" (404).
# Recomendado en produccion si usted entra siempre desde IP fija. Ej: OPERADOR_IPS_PERMITIDAS=200.10.10.5,127.0.0.1
# OPERADOR_IPS_PERMITIDAS=

# --- Sitio publico (/web) ---
# Nombre comercial que muestra la pagina promocional (por defecto "API SUNAT").
# SITIO_NOMBRE=MiMarca
# Direccion base donde viven la API, el portal y la documentacion, si NO cuelgan de la carpeta superior del sitio.
# Ej.: si el sitio esta en la raiz del dominio y la API en https://api.midominio.com -> SITIO_URL_APP=https://api.midominio.com
# SITIO_URL_APP=

# --- Verificacion publica de documentos, respaldos y puesta en produccion (ver docs/DESPLIEGUE.md) ---
# Direccion publica de la pagina (donde vive /verificar). Por defecto se deduce de API_BASE_URL + /web.
# SITIO_URL=https://www.midominio.com
# Carpeta de respaldos (por defecto storage/respaldos). Mejor un disco aparte; copie los respaldos FUERA del servidor.
# RESPALDO_DIR=/var/backups/api-sunat
# Ruta de pg_dump si no esta en el PATH (respaldos con PostgreSQL)
# PG_DUMP_PATH=/usr/bin/pg_dump
