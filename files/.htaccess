# Aqui se guardan XML, CDR y PDF. Las respuestas de la API devuelven enlaces directos
# a estos archivos, por eso solo se permiten estas extensiones. Todo lo demas
# (json, txt, php, logs...) queda bloqueado. Sin listado de carpetas.
Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

<FilesMatch "\.(xml|zip|pdf|png)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Allow from all
  </IfModule>
</FilesMatch>
