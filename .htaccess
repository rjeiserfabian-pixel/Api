<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pasa la cabecera Authorization a PHP (Apache la descarta por defecto)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # API v1: todo /v1/... entra por un unico punto
  RewriteRule ^v1(/.*)?$ v1/index.php [L,QSA]
</IfModule>

# No listar el contenido de las carpetas
Options -Indexes

# Repositorio git: nunca debe poder descargarse por web
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.git(/|$) - [R=404,L]
</IfModule>

# Archivos sensibles o de diagnostico: bloqueados por web
<FilesMatch "(^\.|\.(pem|pfx|p12|key|log|sql|bak|md|lock)$|^(test_.*|check_cert|testing)\.php$|^respuesta_oauth\.txt$|^composer\.json$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
