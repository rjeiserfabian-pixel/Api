# ===========================================================================================================
# .env de PRODUCCION (ejemplo). Copielo como /var/www/api-sunat/.env y complete los valores.
#   chmod 600 .env && chown www-data:www-data .env
# NUNCA suba este archivo a git ni lo envie por correo/chat. APP_KEY: haga una copia en su gestor de contrasenas.
# Verifique todo con:  php bin/verificar.php --produccion
# ===========================================================================================================

# --- Claves (las genera:  php bin/admin.php init ) ---------------------------------------------------------
APP_KEY=
INTERNAL_TOKEN=

# --- Seguridad del motor y de las pantallas ---------------------------------------------------------------
BLOQUEAR_LEGACY=1
PORTAL_REQUIERE_HTTPS=1
# Solo si hay un proxy/balanceador que termina el HTTPS y envia X-Forwarded-Proto:
# PORTAL_PROXY_CONFIABLE=1
# Panel del operador solo desde sus IP (separadas por coma). Muy recomendable:
# OPERADOR_IPS_PERMITIDAS=200.10.10.5

# --- Direcciones ---------------------------------------------------------------------------------------------
# Publica de la API (sin barra final). Los enlaces a XML/CDR/PDF y los avisos la usan.
API_BASE_URL=https://api.midominio.com
# Interna: el puerto 127.0.0.1:8081 de deploy/apache-sitios.conf (la API llama al motor por aqui)
API_INTERNAL_URL=http://127.0.0.1:8081
# Pagina publica (donde vive la verificacion de documentos) y donde estan la API/portal/docs
SITIO_URL=https://www.midominio.com
SITIO_URL_APP=https://api.midominio.com
SITIO_NOMBRE=MiMarca

# --- Base de datos (PostgreSQL recomendado) ------------------------------------------------------------------
# Para empezar con SQLite deje estas 3 lineas vacias/comentadas.
DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=api_sunat
DB_USER=api_sunat
DB_PASS=

# --- Respaldos ------------------------------------------------------------------------------------------------------
# Carpeta de respaldos (mejor un disco aparte). Por defecto storage/respaldos.
# RESPALDO_DIR=/var/backups/api-sunat

# --- Cargador de certificados antiguo (upload_cert.php): dejelo VACIO para desactivarlo ---------------------
ADMIN_USER=
ADMIN_PASS_HASH=
